        "    with open(CSV_PATH, 'rb') as f:\n",
        "        zip_content = io.BytesIO(f.read())\n",
        "    with zipfile.ZipFile(zip_content, 'r') as zf:\n",
        "        csv_filenames = [name for name in zf.namelist() if name.endswith('.csv')]\n",
        "        if not csv_filenames:\n",
        "            raise ValueError(\"No CSV file found inside the uploaded ZIP archive. Please upload a ZIP containing a CSV or a direct CSV file.\")\n",
        "        # Assuming there is only one CSV file in the zip\n",
        "        csv_filename = csv_filenames[0]\n",
        "        with zf.open(csv_filename) as csv_file:\n",
        "            df = pd.read_csv(csv_file)\n",
        "            if \"label\" not in df.columns and \"text\" not in df.columns:\n",
        "                # Re-read skipping the first row if headers are misplaced\n",
        "                csv_file.seek(0)\n",
